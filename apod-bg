#!/bin/bash
# Sets the GNOME wallpaper to NASA's Astronomy Picture of the Day.
# Uses the new NASA Science feed (no API key needed).

API_URL="https://science.nasa.gov/wp-json/wp/v2/apod-basic"
SERVICE_NAME="apod-bg"

# APOD publishes around 05:00 UTC; run 1 hour later, converted to local time
LOCAL_TIME=$(date -d '06:00 UTC today' +%H:%M)

print_info() {
  echo "  - Daily at $LOCAL_TIME (1 hour after NASA updates at 05:00 UTC)"
  echo "  - When waking from sleep/suspend (if scheduled time was missed)"
  echo "  - On boot (if laptop was off during scheduled time)"
  echo ""
  echo "Useful commands:"
  echo "  Check timer status:    systemctl --user status $SERVICE_NAME.timer"
  echo "  Check service status:  systemctl --user status $SERVICE_NAME.service"
  echo "  Check resume service:  systemctl --user status $SERVICE_NAME-resume.service"
  echo "  View timer schedule:   systemctl --user list-timers"
  echo "  Run manually now:      systemctl --user start $SERVICE_NAME.service"
  echo "  View logs:             journalctl --user -u $SERVICE_NAME.service"
  echo "  Disable timer:         systemctl --user disable $SERVICE_NAME.timer"
  echo "  Stop timer:            systemctl --user stop $SERVICE_NAME.timer"
}

install_timer() {
  local script_path
  script_path=$(realpath "$0")
  local config_dir="$HOME/.config/systemd/user"

  mkdir -p "$config_dir"

  # service
  cat >"$config_dir/$SERVICE_NAME.service" <<EOF
[Unit]
Description=NASA APOD Background Updater
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash $script_path
EOF

  # timer
  cat >"$config_dir/$SERVICE_NAME.timer" <<EOF
[Unit]
Description=Daily NASA APOD Background Update Timer

[Timer]
OnCalendar=$LOCAL_TIME
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
EOF

  # resume service; runs when waking from sleep
  cat >"$config_dir/$SERVICE_NAME-resume.service" <<EOF
[Unit]
Description=NASA APOD Background Updater (on resume from sleep)
After=suspend.target

[Service]
Type=oneshot
# Small delay to ensure network is up
ExecStartPre=/bin/sleep 30
ExecStart=/bin/bash $script_path

[Install]
WantedBy=suspend.target
EOF

  systemctl --user daemon-reload
  systemctl --user enable "$SERVICE_NAME.timer"
  systemctl --user start "$SERVICE_NAME.timer"
  systemctl --user enable "$SERVICE_NAME-resume.service"

  echo "Systemd timer installed successfully!"
  echo ""
  print_info
}

case "$1" in
--install-timer)
  install_timer
  exit 0
  ;;
--info)
  echo "$SERVICE_NAME service:"
  print_info
  exit 0
  ;;
esac

# ---------------------------------------------------------------------------

path="$HOME/apod-images" # use absolute path
new_img_name="today-nasa-apod.jpg"
img_path="$path/$new_img_name"
placeholder_bg_path="$path/placeholder.jpg"

mkdir -p "$path"

set_bg() {
  local uri
  uri="file://$(realpath "$1")"
  dconf write /org/gnome/desktop/background/picture-uri-dark "'$uri'"
  dconf write /org/gnome/desktop/background/picture-uri "'$uri'"
}

# Download the newest *image* entry in the feed once, to use as a fallback.
ensure_placeholder() {
  [ -f "$placeholder_bg_path" ] && return 0
  [ -z "$json_resp" ] && return 1

  local url
  url=$(jq -r 'map(select(.media_type == "image" and .hdurl)) | .[0].hdurl // empty' <<<"$json_resp" 2>/dev/null)
  if [[ -n "$url" ]] && curl -fsSL --max-time 120 -o "$placeholder_bg_path.tmp" "$url"; then
    mv "$placeholder_bg_path.tmp" "$placeholder_bg_path"
  else
    rm -f "$placeholder_bg_path.tmp"
    echo "Warning: could not download placeholder image" >&2
    return 1
  fi
}

use_placeholder() {
  if ensure_placeholder; then
    set_bg "$placeholder_bg_path"
  fi
}

dconf write /org/gnome/desktop/background/picture-options "'scaled'"

# fetch apod feed (JSON array, newest entry first)
json_resp=$(curl -fsS --max-time 30 "$API_URL")

if [[ -z "$json_resp" ]] || ! jq -e 'type == "array" and length > 0' <<<"$json_resp" >/dev/null 2>&1; then
  echo "failed to fetch apod feed"
  if [ -f "$img_path" ]; then
    echo "keeping current wallpaper"
  else
    echo "no previous image found; using placeholder if available"
    use_placeholder
  fi
  exit 1
fi

apod_date=$(jq -r '.[0].date' <<<"$json_resp")
# APOD dates follow US Eastern time
today_date=$(TZ=America/New_York date +%Y-%m-%d)

# if the feed hasn't published today's entry yet, keep current wallpaper
if [[ "$apod_date" != "$today_date" ]]; then
  if [ -f "$img_path" ]; then
    echo "Feed not updated yet; keep current wallpaper"
  else
    echo "Feed not updated yet and no previous image found; using placeholder as wallpaper"
    use_placeholder
  fi
  exit 0
fi

media_type=$(jq -r '.[0].media_type' <<<"$json_resp")
if [[ "$media_type" != "image" ]]; then
  echo "media type is '$media_type', not image; using placeholder"
  use_placeholder
  exit 0
fi

# NOTE: in this feed `.url` is the article page, not the image. Use `.hdurl`.
img_url=$(jq -r '.[0].hdurl // empty' <<<"$json_resp")
if [[ -z "$img_url" ]]; then
  echo "no image url in feed entry; using placeholder"
  use_placeholder
  exit 1
fi

# download to a temp file first so a failed download never clobbers the old image
if curl -fsSL --max-time 120 -o "$img_path.tmp" "$img_url"; then
  mv "$img_path.tmp" "$img_path"
  set_bg "$img_path"
  echo "✔ wallpaper is successfully updated"
else
  rm -f "$img_path.tmp"
  echo "failed to download image"
  if [ -f "$img_path" ]; then
    echo "keeping current wallpaper"
  else
    use_placeholder
  fi
  exit 1
fi

